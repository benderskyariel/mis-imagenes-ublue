{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned Fedora image-version in each recipe when its base-image publishes a new tag",
      "managerFilePatterns": ["/^recipes\\/.*\\.ya?ml$/"],
      "matchStrings": [
        "base-image:\\s*(?<depName>\\S+)\\s*\\n\\s*image-version:\\s*[\"']?(?<currentValue>\\d+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchDepNames": [
        "ghcr.io/ublue-os/silverblue-main",
        "ghcr.io/ublue-os/silverblue-nvidia"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
